# ==============================================================================
# Accuro — CA Firm Accounting Automation Environment Configuration
# Tagline: Accurate accounts. You review, Accuro does the rest.
# ==============================================================================

PROJECT_NAME=Accuro
TAGLINE="Accurate accounts. You review, Accuro does the rest."
ENVIRONMENT=production
DEBUG=False

# -----------------
# Security & Authentication
# -----------------
SECRET_KEY=accuro-production-grade-super-secret-key-32charsmin!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------
# Database Configuration
# -----------------
# Docker Compose Postgres:
DATABASE_URL=postgresql://accuro:accuro_secure_password_2025!@accuro-db:5432/accuro
# Local SQLite development fallback:
# DATABASE_URL=sqlite:///./accuro.db

# -----------------
# Message Broker & Background Worker Queue
# -----------------
REDIS_URL=redis://accuro-redis:6379/0

# -----------------
# Document Storage (Immutably Stored with SHA-256 Hash)
# -----------------
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./storage
# Optional S3-compatible configuration (AWS S3 / Cloudflare R2 / MinIO)
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# S3_BUCKET=accuro-documents
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key

# -----------------
# AI Vision Extraction Provider
# -----------------
# "deterministic_mock": High-accuracy rule & bounding-box extractor (runs standalone without API key)
# "vision_llm": Pluggable Vision LLM API (OpenAI / Gemini)
AI_PROVIDER=deterministic_mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# -----------------
# India DPDP Act Compliance & Data Protection
# -----------------
# 32-byte secret key for AES-256 field-level encryption of PAN, GSTIN & Bank Account numbers
DPDP_FIELD_ENCRYPTION_KEY=accuro_dpdp_encryption_secret_key_32b!
DEFAULT_DATA_RETENTION_YEARS=8

# -----------------
# CA Productivity Benchmark Configuration
# -----------------
# Estimated standard CA manual entry benchmark minutes per invoice
MANUAL_ENTRY_BENCHMARK_MINUTES=15.0

# -----------------
# Frontend Configuration
# -----------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
